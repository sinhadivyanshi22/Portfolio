# Copy this file to `backend/.env` and fill in real values. Never commit `.env`.

# Server
# Pick a port nothing else uses. VS Code already holds 3000 and 3001.
PORT=4173

# Set to your deployed origin(s), comma separated, e.g. https://yourdomain.com
ALLOWED_ORIGIN=http://localhost:4173

# Where submissions are delivered
MAIL_TO=sinhadivyanshi2205@gmail.com
MAIL_FROM=onboarding@resend.dev

# Email provider: "smtp" (default) or "resend"
EMAIL_PROVIDER=resend

# Resend (https://resend.com) — get your API key at https://resend.com/api-keys
# Use this instead of SMTP_* when EMAIL_PROVIDER=resend
RESEND_API_KEY=your-resend-api-key

# SMTP (Gmail example) — only needed when EMAIL_PROVIDER=smtp
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password:  https:// myaccount.google.com/apppasswords
# 3. Paste the 16-character code below (no spaces). Your normal Google
#    password will NOT work here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sinhadivyanshi2205@gmail.com
SMTP_PASS=your-16-char-app-password
